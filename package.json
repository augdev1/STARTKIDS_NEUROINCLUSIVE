{
  "name": "starkids",
  "version": "1.0.0",
  "description": "StarKids - Jogos Educativos e Acolhedores com Persistência em PostgreSQL",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/**/*.test.js",
    "test:api": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/api/*.test.js",
    "test:unit": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/unit/*.test.js",
    "test:coverage": "node --env-file-if-exists=.env.test --test --test-concurrency=1 --experimental-test-coverage tests/**/*.test.js",
    "test:harness": "npm run test:syntax && npm run test",
    "test:syntax": "node --check server/server.js && node --check server/db.js && node --check server/auth.js && node --check server/logger.js",
    "ship": "node scripts/push-deploy.js",
    "deploy": "node scripts/push-deploy.js",
    "auto": "node scripts/auto-sync.js",
    "watch": "node scripts/auto-sync.js"
  },
  "keywords": [
    "starkids",
    "neurodivergent",
    "education",
    "games",
    "postgresql",
    "docker",
    "vercel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "msedge-tts": "^2.0.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
