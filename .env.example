# Configurações de Porta e Ambiente
PORT=8085
NODE_ENV=production

# URL de Conexão com o Banco PostgreSQL
# Em desenvolvimento local (Docker Compose):
# DATABASE_URL=postgres://starkids:starkids_pass@localhost:5433/starkids_db
#
# No Render / Nuvem (substitua com a URL gerada pelo Render):
# DATABASE_URL=postgres://starkids:sua_senha@dpg-xxxxxx-a.oregon-postgres.render.com/starkids_db
DATABASE_URL=postgres://starkids:starkids_pass@localhost:5433/starkids_db

# Chave Secreta para Sessões e Assinatura de Tokens
SESSION_SECRET=starkids_super_secret_chave_segura_2026

# (Opcional) URL da API do Backend caso o Frontend no Vercel consuma o Render externamente
# VITE_API_URL=https://starkids-api.onrender.com
